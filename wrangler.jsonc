{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Worker名（「Deploy to Cloudflare」の設定画面で変更できる）
	"name": "rensupe-lp",
	"main": "src/index.tsx",
	"compatibility_date": "2026-10-01",
	"observability": {
		"enabled": true
	},
	// 公開URLは https://<Worker名>.<アカウントのサブドメイン>.workers.dev
	// 独自ドメインはデプロイ後に Cloudflare ダッシュボードの Worker 設定から追加する
	"workers_dev": true,
	// TailwindでビルドしたCSSなどの静的ファイル
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	// 料金・FAQ・設備などのLP内容
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "rensupe-lp",
			// デプロイ時に、新しく作成されたデータベースのIDへ自動で書き換わる
			"database_id": "00000000-0000-0000-0000-000000000000",
			"migrations_dir": "migrations"
		}
	],
	// 写真
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "rensupe-lp-images"
		}
	]
}
