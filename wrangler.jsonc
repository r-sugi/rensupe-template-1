{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "povit-lp",
	"main": "src/index.tsx",
	"compatibility_date": "2026-10-01",
	"account_id": "9a93e379d73896df4f9234ac783ad6cb",
	"observability": {
		"enabled": true
	},
	// 公開URL（karibako.com のゾーンに Custom Domain として割り当て）
	"routes": [
		{
			"pattern": "karibako.com",
			"custom_domain": true
		}
	],
	"workers_dev": false,
	// TailwindでビルドしたCSSなどの静的ファイル
	"assets": {
		"directory": "./public",
		"binding": "ASSETS"
	},
	// 料金・FAQ・設備などのLP内容
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "povit-lp",
			// `wrangler d1 create povit-lp` で表示されたIDに置き換える
			"database_id": "fa5c95c0-ecc6-47e1-981c-b675b227ae68",
			"migrations_dir": "migrations"
		}
	],
	// 写真（初回アクセス時に image_sources の取得元から自動で保存される）
	"r2_buckets": [
		{
			"binding": "IMAGES",
			"bucket_name": "povit-lp-images"
		},
		{
			"bucket_name": "povit-lp-images",
			"binding": "lp_public_images"
		}
	]
}