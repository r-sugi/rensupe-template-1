{
  "name": "rensupe-lp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/assets/styles.css --minify",
    "watch:css": "tailwindcss -i ./src/styles.css -o ./public/assets/styles.css --watch",
    "dev": "npm run build:css && npm run db:migrate:local && npm run content:sync:local && concurrently -k -n css,worker \"npm:watch:css\" \"wrangler dev\"",
    "deploy": "npm run build:css && npm run db:migrate:remote && npm run content:sync:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "release": "bash ./scripts/release.sh",
    "typecheck": "wrangler types && tsc --noEmit",
    "cf-typegen": "wrangler types",
    "content:sync:local": "node scripts/sync-content.mjs --local",
    "content:sync:remote": "node scripts/sync-content.mjs --remote"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "concurrently": "10.0.6",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "wrangler": "4.151.1",
    "yaml": "2.9.1"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "LPの文言・料金・FAQ・設備などを保存するデータベース。名前はそのままで大丈夫です"
      },
      "IMAGES": {
        "description": "写真を保存する場所（R2）。**事前にCloudflareダッシュボードでR2を有効化**しておいてください"
      }
    }
  }
}
